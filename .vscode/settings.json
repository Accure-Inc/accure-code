{
  "[mdx]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "files.exclude": {
    "packages/accure-vscode/out": false,
    "packages/accure-vscode/dist": false
  },
  "search.exclude": {
    "packages/accure-vscode/out": true,
    "packages/accure-vscode/dist": true
  },
  "typescript.tsc.autoDetect": "off",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/.next/**": true
  }
}
